# --- API base URL -----------------------------------------------------------
# Usually leave this UNSET. The client then calls the same-origin path `/api/*`
# in every Vite build:
#   - `npm run dev`   -> vite.config.js proxies /api/* to the backend.
#   - `npm run build` -> vercel.json rewrites /api/* to the backend.
# Both avoid a cross-origin request (and its CORS preflight) to the backend.
# Plain Node tooling (scripts/*) still calls http://16.16.137.75 directly.
#
# Set it to point somewhere else (e.g. a local backend, or to force the hosted
# URL in dev). Trailing slash is trimmed. The Postman collection's {{baseUrl}}
# maps to this value.
# VITE_API_BASE_URL=http://16.16.137.75

# Where the dev proxy forwards `/api/*` (only used by `npm run dev`).
# VITE_DEV_API_PROXY_TARGET=http://16.16.137.75

# Optional: per-request timeout in milliseconds (0 disables it). Default 30000.
# VITE_API_TIMEOUT_MS=30000

# --- Super Admin panel -------------------------------------------------------
# No frontend setting. Access to /admin/* is decided by the backend
# (GET /admin/me): set PLATFORM_SUPER_ADMIN_EMAILS in the *backend*
# environment for bootstrap Super Admins; further operators get platform
# roles from the admin panel's Roles & Permissions page.
