# --- API base URL -----------------------------------------------------------
# Usually leave this UNSET. The client then calls the same-origin path `/api/*`
# in every Vite build:
#   - `npm run dev`   -> vite.config.js proxies /api/* to the backend.
#   - `npm run build` -> vercel.json rewrites /api/* to the backend.
# Both avoid a cross-origin request (and its CORS preflight) to the backend.
# Plain Node tooling (scripts/*) still calls https://vetta-backend.vercel.app
# directly.
#
# Set it to point somewhere else (e.g. a local backend, or to force the hosted
# URL in dev). Trailing slash is trimmed. The Postman collection's {{baseUrl}}
# maps to this value.
# VITE_API_BASE_URL=https://vetta-backend.vercel.app

# Where the dev proxy forwards `/api/*` (only used by `npm run dev`).
# VITE_DEV_API_PROXY_TARGET=http://localhost:3000

# Optional: per-request timeout in milliseconds (0 disables it). Default 30000.
# VITE_API_TIMEOUT_MS=30000

# --- Super Admin panel -------------------------------------------------------
# TEMPORARY, client-side-only gate for /admin/*: a comma-separated list of
# emails allowed into the Super Admin panel. This is NOT server-enforced — the
# backend has no platform-wide role yet (see BACKEND_ISSUES.md). Every
# admin.* API call is also mock-fallback until real /admin/* endpoints exist.
# See src/admin/rbac/superAdminGate.js for the single swap point to a real
# `user.role === 'SUPER_ADMIN'` check once the backend ships one.
# VITE_SUPER_ADMIN_EMAILS=you@vetta.ai,ops@vetta.ai
